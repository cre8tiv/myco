{
  "name": "myco",
  "private": true,
  "type": "module",
  "description": "Test and CI tooling for the myco plugin marketplace. The plugins themselves have no dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:versions": "node scripts/check-version-bumps.mjs",
    "eval": "claude plugin eval . --tag portable --scaffold --ablation none --trust-plugin --no-publish --max-cost-usd 10",
    "eval:all": "claude plugin eval . --scaffold --ablation none --trust-plugin --no-publish --max-cost-usd 10"
  }
}
