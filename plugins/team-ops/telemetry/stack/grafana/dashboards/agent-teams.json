{
  "uid": "agent-teams",
  "title": "Agent teams",
  "tags": [
    "claude-code",
    "team-ops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Claude Code cost per person and model; agent-team cost, friction and tool failures per unit of work and agent (team-ops). Costs are API-equivalent estimates at list prices.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "logs",
        "label": "Events",
        "type": "datasource",
        "query": "loki",
        "current": {}
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(team_ops_work_cost_USD_total, team_ops_stream)",
          "refId": "S"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Claude Code cost",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (max_over_time(claude_code_cost_usage_USD_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "Everything Claude Code spent in the range, from its own metrics. API-equivalent estimate.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Agent-team work",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (max_over_time(team_ops_work_cost_USD_total{team_ops_stream=~\"$stream\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "Cost of agent-team work in the range, from team-ops. Reported when a session or team agent finishes.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Active people",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (user_email) (max_over_time(claude_code_cost_usage_USD_total[$__range])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "People with any Claude Code cost in the range.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Input from cache",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (max_over_time(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[$__range])) / sum (max_over_time(claude_code_token_usage_tokens_total{type=~\"input|cacheRead|cacheCreation\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "Share of input tokens served from the prompt cache. Higher is cheaper.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Cost by unit of work",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (work) (max_over_time(team_ops_work_cost_USD_total{team_ops_stream=~\"$stream\"}[$__range])))",
          "legendFormat": "{{work}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Design rounds, build phases and tickets, as leads named them with team-ops:start-work. \"(untagged)\" is work done before tagging or outside a lead session.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.work}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 6,
      "title": "Cost by agent",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (agent) (max_over_time(team_ops_work_cost_USD_total{team_ops_stream=~\"$stream\"}[$__range])))",
          "legendFormat": "{{agent}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Agent-team cost per agent type, leads included.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 7,
      "title": "Cost by person",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (user_email) (max_over_time(claude_code_cost_usage_USD_total[$__range])))",
          "legendFormat": "{{user_email}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "All Claude Code cost per person, from Claude Code's own metrics.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.user_email}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 8,
      "title": "Cost by model",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (model) (max_over_time(claude_code_cost_usage_USD_total[$__range])))",
          "legendFormat": "{{model}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "All Claude Code cost per model.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "displayName": "${__field.labels.model}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 9,
      "title": "Spend rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total[$__rate_interval])) * 3600",
          "legendFormat": "{{model}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "Claude Code spend in dollars per hour, by model.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "interval": "1m"
    },
    {
      "id": 10,
      "type": "row",
      "title": "Events",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Friction by kind",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sort_desc(sum by (friction_kind) (count_over_time({service_name=\"team-ops\"} | event_name=~\"team_ops.friction\" | team_ops_stream=~\"$stream\" [$__range])))",
          "legendFormat": "{{friction_kind}}",
          "queryType": "range"
        }
      ],
      "maxDataPoints": 1,
      "description": "Process friction agents reported with team-ops:log-friction, by kind. handoff includes design problems sent back from engineering.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "displayName": "${__field.labels.friction_kind}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 12,
      "title": "Friction by agent",
      "type": "bargauge",
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sort_desc(sum by (agent) (count_over_time({service_name=\"team-ops\"} | event_name=~\"team_ops.friction\" | team_ops_stream=~\"$stream\" [$__range])))",
          "legendFormat": "{{agent}}",
          "queryType": "range"
        }
      ],
      "maxDataPoints": 1,
      "description": "Who reported the friction.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 13,
      "title": "Tool failures by agent",
      "type": "bargauge",
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sort_desc(sum by (agent) (count_over_time({service_name=\"team-ops\"} | event_name=~\"team_ops.tool_failure\" | team_ops_stream=~\"$stream\" [$__range])))",
          "legendFormat": "{{agent}}",
          "queryType": "range"
        }
      ],
      "maxDataPoints": 1,
      "description": "Failed tool calls by team agents.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "displayName": "${__field.labels.agent}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "text": {
          "titleSize": 13,
          "valueSize": 13
        }
      }
    },
    {
      "id": 14,
      "title": "Problems per unit of work",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (work, event_name) (count_over_time({service_name=\"team-ops\"} | event_name=~\"team_ops.(tool_failure|permission_denied|friction|stop_failure)\" | team_ops_stream=~\"$stream\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Tool failures, permission denials, friction and failed stops per unit of work. Read it next to Cost by unit of work.",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "event_name",
            "rowField": "work",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "team_ops.(.*)",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Friction reports",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=\"team-ops\"} | event_name=~\"team_ops.friction\" | team_ops_stream=~\"$stream\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "description": "Each report with its agent, kind and work. The text shows only when TEAM_OPS_OTLP_LOG_CONTENT=1.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
