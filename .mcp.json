{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless",
        "--ignore-https-errors",
        "--viewport-size",
        "1280x800",
        "--output-dir",
        ".claude/qa/runs/_artifacts"
      ],
      "env": {}
    }
  }
}
